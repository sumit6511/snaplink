# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
BASE_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/snaplink

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Short links
SHORT_CODE_LENGTH=7

# Email (password reset / verification) — optional. Without RESEND_API_KEY,
# emails are logged instead of sent, so the app still works without one.
RESEND_API_KEY=
EMAIL_FROM=SnapLink <onboarding@resend.dev>
